# Xcode 26+ requires deployment target >= 15.0
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def flick_development_team
  signing = File.expand_path('Flutter/Signing.local.xcconfig', __dir__)
  return nil unless File.exist?(signing)

  File.foreach(signing) do |line|
    next if line.strip.start_with?('//', '#')
    m = line.match(/DEVELOPMENT_TEAM\s*=\s*([A-Z0-9]{10})/)
    return m[1] if m
  end
  nil
end

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # Force Xcode 26/27-safe RevenueCat (PaywallColor init fix shipped in 5.78.0).
  # If this conflicts, your Flutter plugin is still on purchases_flutter 9.x —
  # run `flutter pub get` and delete ios/Pods + ios/Podfile.lock.
  pod 'RevenueCat', '5.90.2'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  team = flick_development_team
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
      if team
        config.build_settings['DEVELOPMENT_TEAM'] = team
        config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
      end
    end
  end

  if team
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['DEVELOPMENT_TEAM'] = team
    end
    Pod::UI.puts "Pods DEVELOPMENT_TEAM=#{team} (from Flutter/Signing.local.xcconfig)"
  else
    Pod::UI.puts <<~WARN

      ⚠️  No app/ios/Flutter/Signing.local.xcconfig — device install often fails after build.
      Run from repo root:  FLICK_IOS_TEAM=YOUR10CHARID bash scripts/ios-configure-signing.sh
      Then:  cd app/ios && pod install
    WARN
  end

  lock_path = File.join(__dir__, 'Podfile.lock')
  if File.exist?(lock_path)
    lock = File.read(lock_path)
    if lock =~ /RevenueCat \((\d+\.\d+\.\d+)\)/
      version = Gem::Version.new(Regexp.last_match(1))
      if version < Gem::Version.new('5.78.0')
        raise <<~MSG

          RevenueCat #{version} is too old for this Xcode (PaywallColor init error).
          Need >= 5.78.0. From app/:
            flutter pub get
            rm -rf ios/Pods ios/Podfile.lock ios/.symlinks
            cd ios && pod install
        MSG
      end
      Pod::UI.puts "Using RevenueCat #{version}"
    end
  end
end
